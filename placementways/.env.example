# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored -- never commit real secrets.

# Supabase: Project Settings -> API
# The anon / publishable key is designed to be public; it is safe because every
# table has Row Level Security. Do NOT put the service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for guest mocks, coding workers, private storage and verified payments.
SUPABASE_SERVICE_ROLE_KEY=

# App: public origin used in email links. Use your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Guest mocks use the server-only service role for tightly scoped guest RPCs.
# Generate a private random secret (at least 32 characters). Never expose it publicly.
GUEST_RATE_LIMIT_SECRET=
# Set only to a header your trusted reverse proxy OVERWRITES with a single visitor IP.
# Requests without a valid address fail closed; do not blindly use x-forwarded-for.
GUEST_TRUSTED_IP_HEADER=

# Set production only for the real public deployment; staging stays noindex.
DEPLOYMENT_ENV=staging
# Isolated Judge0-compatible provider, used only by the separate coding worker.
# Never use a public demo endpoint for student submissions.
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
# Optional RapidAPI gateway credentials; see scripts/lib/judge0.mjs.
JUDGE0_RAPIDAPI_KEY=
# Stripe is optional; enable purchases in Admin only after test-mode verification.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=false
# Local emulator overrides only. Leave unset in production.
# STRIPE_API_BASE=http://127.0.0.1:4010
# ALLOW_LOCAL_SERVICES=true

# Recruitment monitoring: hosts must be explicitly allowlisted (comma separated),
# e.g. careers.example.com,another-employer.example (NOT wildcards).
RECRUITMENT_ALLOWED_HOSTS=
# >=32 random characters; scheduler POST /api/cron/recruitment Bearer token.
RECRUITMENT_CRON_SECRET=
# Optional server-side AI extraction. Without it changes become manual-review drafts.
OPENAI_API_KEY=
RECRUITMENT_AI_MODEL=gpt-4o-mini
# Keep false in the free public launch. Future releases may enable commerce.
PLACEMENTWAYS_ENABLE_COMMERCE=false

# Milestone 02: runtime requires `pdftotext` (poppler-utils) for official PDF notices.
# Redirects and private-network/unknown hosts are blocked; JS-only pages need approved adapters.
# Configure scheduled POST /api/cron/recruitment externally; keep source-monitoring credentials server-only.

# Milestone 5: Anonymous coding is disabled until a trusted ingress IP header,
# 32+ char guest rate secret and a live isolated coding worker are configured.
# A wrong/missing trusted ingress IP header causes anonymous execution to fail closed.
# Guided SQL Lab at /sql runs locally in the browser and needs no SQL credentials.
# To check recruitment-source coverage, use: npm run report:coverage (server-only credentials).

# Milestone 6: For READ-ONLY staging smoke tests after HTTPS deployment (never store a URL with credentials).
# STAGING_BASE_URL=https://staging.example.com
# npm run smoke:staging
# npm run test:quality (content review) and npm run test:staging-smoke (mock HTTP assertions)

# Milestone 7: isolated HTTPS staging verification (do not set true without
# independently verifying that staging points to a separate Supabase project).
# STAGING_BASE_URL=https://staging.your-domain.example/
# STAGING_DB_ISOLATED=true
# npm run check:staging
# npm run check:staging -- --require-ai --require-coding

# Protected Vercel Preview QA, see docs/VERCEL_STAGING.md.
# GUEST_TRUSTED_IP_HEADER=x-vercel-forwarded-for
# STAGING_SUPABASE_PROJECT_REF=
# VERCEL_AUTOMATION_BYPASS_SECRET=
# Set the Vercel bypass token only in a protected QA or scheduler environment.
