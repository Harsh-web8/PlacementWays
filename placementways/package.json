{
  "name": "placementways",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "bash supabase/tests/run.sh",
    "db:types": "node scripts/gen-db-types.mjs",
    "db:plan": "node scripts/plan-migrations.mjs",
    "test:e2e": "node tests/e2e/public-launch.mjs",
    "worker:coding": "node scripts/coding-worker.mjs",
    "check:production": "node scripts/check-production.mjs",
    "test:discovery": "node --experimental-strip-types --test tests/recruitment/discovery-core.test.mjs",
    "test:sql": "node --experimental-strip-types --test tests/sql/guided-sql.test.mjs",
    "report:coverage": "node scripts/report-recruitment-coverage.mjs",
    "test:quality": "node --experimental-strip-types --test tests/recruitment/quality.test.mjs",
    "test:staging-smoke": "node --test tests/release/staging-smoke.test.mjs",
    "smoke:staging": "node scripts/staging-smoke.mjs",
    "browser:staging": "node scripts/staging-browser.mjs",
    "recruitment:staging": "node scripts/staging-recruitment.mjs",
    "scan:staging": "node scripts/scan-staging.mjs",
    "inspect:staging": "node scripts/inspect-staging.mjs",
    "test:staging-acceptance": "node --test tests/release/staging-acceptance.test.mjs",
    "cleanup:guest-coding": "node scripts/cleanup-guest-coding.mjs",
    "test:monitor": "node --experimental-strip-types --test tests/recruitment/monitor-policy.test.mjs",
    "test:e2e:legacy": "node tests/e2e/smoke.mjs",
    "check:staging": "node scripts/check-staging.mjs",
    "test:staging-config": "node --test tests/release/staging-config.test.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "16.4.6",
    "papaparse": "^5.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pg": "^8.23.0",
    "playwright-core": "1.65.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
