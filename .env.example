# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored -- never commit real secrets.

# Supabase: Project Settings -> API
# The anon / publishable key is designed to be public; it is safe because every
# table has Row Level Security. Do NOT put the service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://gdvblxxnxhtmaxlatopm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_44wPGzDhcLQBnGxO3ig5iQ_4QrUgbQL

# Server-only key for guest mocks, coding workers, private storage and verified payments.
SUPABASE_SERVICE_ROLE_KEY=

# App: public origin used in email links. Use your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Guest mocks use the server-only service role for tightly scoped guest RPCs.
# Generate a private random secret (at least 32 characters). Never expose it publicly.
GUEST_RATE_LIMIT_SECRET=
# Set only to a header your trusted reverse proxy OVERWRITES with a single visitor IP.
# Requests without a valid address fail closed; do not blindly use x-forwarded-for.
GUEST_TRUSTED_IP_HEADER=

# Set production only for the real public deployment; staging stays noindex.
DEPLOYMENT_ENV=staging
# Isolated Judge0-compatible provider, used only by the separate coding worker.
# Never use a public demo endpoint for student submissions.
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
# Optional RapidAPI gateway credentials; see scripts/lib/judge0.mjs.
JUDGE0_RAPIDAPI_KEY=
# Stripe is optional; enable purchases in Admin only after test-mode verification.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=false
# Local emulator overrides only. Leave unset in production.
# STRIPE_API_BASE=http://127.0.0.1:4010
# ALLOW_LOCAL_SERVICES=true
